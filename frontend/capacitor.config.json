{
  "appId": "edu.sust.cse.portal",
  "appName": "SUST CSE Portal",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#F7F8FA",
      "overlaysWebView": false
    }
  }
}
